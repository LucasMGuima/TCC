@startuml
actor App
participant MARS
participant SCORE
database Database

App -> Database : Modelos disponíveis
activate Database
App <- Database
App -> Database : Dados disponíveis
App <- Database
deactivate Database

App -> MARS : Treino do modelo
activate MARS
App <- MARS
deactivate MARS

App -> SCORE : Avalia o modelo
activate SCORE
App <- SCORE
deactivate SCORE 

@enduml